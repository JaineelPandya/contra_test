# App Settings
APP_NAME=RegGraph
APP_ENV=development
DEBUG=true
PORT=8080
HOST=0.0.0.0

# Upload directory
UPLOAD_DIR=uploads

# Neo4j Settings
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=reggraph_password
NEO4J_DATABASE=neo4j

# LLM Provider: "groq", "gemini", "ollama", "openai", or "mock"
LLM_PROVIDER=groq

# Groq Settings (Default Active Provider)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEMPERATURE=0.0

# Google Gemini Settings
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.0

# Ollama Settings (used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TEMPERATURE=0.0

# OpenAI-Compatible API Settings (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# Chunking & Processing Settings
MAX_CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
MAX_CONCURRENT_CHUNKS=4
